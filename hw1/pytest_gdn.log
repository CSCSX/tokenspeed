                q,
                k,
                v,
                pool,
                parents,
                rows=rows,
                A_log=A_log,
                a=a,
                dt_bias=dt_bias,
                b=b,
                initial_state_indices=torch.arange(batch, device=device, dtype=torch.int32),
                use_qk_l2norm=True,
                **replay,
            )
    
        # V tile tiers: half width at a few requests, full up to one program per SM, wider past it.
